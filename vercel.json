{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/__clone-proxy/:path*", "destination": "/api/clone-proxy?u=:path*" },

    { "source": "/assets/:path*", "destination": "https://www.breakthroughenergy.org/assets/:path*" },

    { "source": "/_nuxt/:path*", "destination": "https://deltacafes.com/_nuxt/:path*" },
    { "source": "/_i18n/:path*", "destination": "https://deltacafes.com/_i18n/:path*" },
    { "source": "/imgs/:path*", "destination": "https://deltacafes.com/imgs/:path*" },
    { "source": "/rives/:path*", "destination": "https://deltacafes.com/rives/:path*" },
    { "source": "/fonts/:path*", "destination": "https://deltacafes.com/fonts/:path*" },
    { "source": "/en/:file(_payload.*)", "destination": "https://deltacafes.com/en/:file" },
    { "source": "/pt/:file(_payload.*)", "destination": "https://deltacafes.com/pt/:file" },

    { "source": "/textures/:path*", "destination": "https://apekon.com/textures/:path*" },
    { "source": "/images/:path*", "destination": "https://apekon.com/images/:path*" },
    { "source": "/models/:path*", "destination": "https://apekon.com/models/:path*" },
    { "source": "/sounds/:path*", "destination": "https://apekon.com/sounds/:path*" },

    { "source": "/_scripts/:path*", "destination": "/_empty.js" }
  ],
  "headers": [
    { "source": "/clones/(.*)", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }] }
  ]
}
